# ---------------------------------------------------------------------------
# Copy to .env — values printed by `supabase start` for local development.
# EXPO_PUBLIC_* vars are embedded in the app bundle: PUBLIC VALUES ONLY.
# The anon key is safe to embed (access is enforced by Postgres RLS).
# Service-role keys / payment secrets live ONLY in EAS + GitHub secrets.
# ---------------------------------------------------------------------------

# local: http://127.0.0.1:54321 · staging/prod: your Supabase project URL
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-from-supabase-start

# build-time (optional in local dev)
APP_VARIANT=development
EAS_PROJECT_ID=
EAS_UPDATE_URL=
